@startuml C1_Context_Main
' =====================================================================
' C4 Level 1 — Context
' Система: Платформа мониторинга свинокомплексов (MVP)
' Вариант: ОСНОВНОЙ — максимальное переиспользование ландшафта «АгроТех Х»
' =====================================================================

!include <C4/C4_Context>

title C1. Платформа мониторинга свинокомплексов — основной вариант\n(переиспользование существующего ландшафта «АгроТех Х»)

LAYOUT_TOP_DOWN()

' ===================== Акторы =====================
Person(дежурный, "Дежурный сотрудник фермы", "Реагирует на инциденты на месте. Должен получать оповещения даже при отсутствии связи с центром")
Person(оператор, "Оператор центрального мониторинга", "Контролирует инциденты, состояние животных и поголовье по всем фермам")
Person(администратор, "Администратор платформы", "Управляет пользователями и ролями, подключает новые фермы и устройства, настраивает правила тревог")
Person(аналитик, "Аналитик", "Строит отчётность по эффективности животноводства")

' ===================== Система в фокусе =====================
System(платформа, "Платформа мониторинга свинокомплексов", "Видеоаналитика поведения и состояния животных, управление кормлением и поением, контроль водоподготовки, пересчёт поголовья, прогноз расхода кормов, оповещение об инцидентах. Каждая ферма работает автономно и синхронизируется с центром")

' ===================== Оборудование ферм =====================
System_Ext(видеонаблюдение, "Системы видеонаблюдения ферм", "IP-камеры и VMS разных производителей: ночная съёмка, «рыбий глаз». Источник видеопотока для аналитики")
System_Ext(оборудование_ферм, "Технологическое оборудование ферм", "Кормушки, поилки, системы фильтрации воды разных производителей. Отдают телеметрию и принимают команды")

' ===================== Существующий ландшафт «АгроТех Х» =====================
System_Ext(корпоративные_данные, "Корпоративная платформа данных", "Шина Apache Kafka и IoT-шлюз, TimescaleDB, Data Lake (MinIO), DWH (ClickHouse), аналитический модуль, Power BI. Единый контур обмена, хранения и анализа данных компании")
System_Ext(ерп, "ERP «1С:Агро»", "Учёт поголовья как актива, складской учёт кормов, закупки, финансы")
System_Ext(клиентские_приложения, "Корпоративные веб-портал и мобильное приложение", "Существующие клиенты (React / Flutter). Дополняются разделами животноводства вместо разработки новых приложений")

' ===================== Прочие внешние системы =====================
System_Ext(идентификация, "Корпоративный провайдер идентификации (IdP)", "Единый вход, MFA, федерация, выдача токенов. В текущем ландшафте отсутствует — требует внедрения")
System_Ext(каналы_оповещения, "Каналы оповещения", "SMS через GSM-модем фермы, локальные сирены и световая сигнализация работают без интернета. Push в мобильное приложение доставляется только при наличии связи")
System_Ext(партнёр_ml, "Партнёрский поставщик ML-моделей", "Передаёт и обновляет обученные модели компьютерного зрения для анализа поведения и состояния животных")

' ===================== Связи: люди =====================
Rel(дежурный, платформа, "Подтверждает отработку инцидента через локальный интерфейс фермы")
Rel(оператор, клиентские_приложения, "Контролирует инциденты и состояние животных по всем фермам", "Веб-портал")
Rel(администратор, платформа, "Настраивает роли, фермы, устройства и правила тревог")
Rel(аналитик, корпоративные_данные, "Строит отчёты по эффективности животноводства", "BI")

' ===================== Связи: оборудование ферм =====================
Rel(видеонаблюдение, платформа, "Передаёт видеопоток для анализа в реальном времени", "RTSP / ONVIF")
Rel(оборудование_ферм, платформа, "Передаёт телеметрию кормления, поения и водоподготовки", "MQTT / Modbus / OPC UA")
Rel(платформа, оборудование_ферм, "Отправляет команды управления кормлением и поением", "MQTT / Modbus")

' ===================== Связи: существующий ландшафт =====================
Rel(платформа, корпоративные_данные, "Публикует инциденты, метрики поголовья и телеметрию", "Kafka")
BiRel(платформа, ерп, "Получает остатки и номенклатуру кормов, передаёт поголовье и фактический расход", "REST")
Rel(клиентские_приложения, платформа, "Запрашивает данные мониторинга и инцидентов", "REST / WebSocket")

' ===================== Связи: прочее =====================
Rel(платформа, идентификация, "Аутентифицирует пользователей и получает их роли", "OIDC / OAuth 2.0")
Rel(платформа, каналы_оповещения, "Отправляет оповещения об инцидентах", "SMS / сирена; push при наличии связи")
Rel(каналы_оповещения, дежурный, "Доставляет оповещение в течение 5 секунд")
Rel(партнёр_ml, платформа, "Поставляет и обновляет ML-модели")

@enduml
