@startuml C2_Isolation_InstancePerTenant
' =====================================================================
' C4 Level 2 — Container (фрагмент)
' Вариант изоляции C: отдельный экземпляр платформы на тенанта
' =====================================================================

!include <C4/C4_Container>

title Вариант C. Изоляция на уровне инстансов\n(выделенный экземпляр платформы на каждого тенанта)

LAYOUT_TOP_DOWN()

Person(клиент_админ, "Администратор клиента", "Агрохолдинг-подписчик")

System_Boundary(saas, "SaaS-платформа мониторинга свинокомплексов") {

  Container_Boundary(control, "Control plane — общий, управляет экземплярами") {
    Container(апи_шлюз, "Публичный API-шлюз", "Kong", "Маршрутизирует запрос в экземпляр тенанта по поддомену или идентификатору")
    Container(оркестратор, "Сервис управления экземплярами", "PHP + Helm / Kubernetes API", "Разворачивает, обновляет и удаляет экземпляр тенанта в отдельном пространстве имён")
    ContainerDb(реестр, "Реестр тенантов", "PostgreSQL", "Тенанты, тарифы, адреса экземпляров, версии развёрнутого ПО")
    Container(биллинг, "Сервис подписок и биллинга", "PHP", "Единый для всех тенантов")
  }

  Container_Boundary(инстанс_a, "Экземпляр тенанта A — отдельное пространство имён") {
    Container(сервисы_a, "Прикладные сервисы тенанта A", "PHP (RoadRunner)", "Полный набор сервисов платформы")
    ContainerDb(бд_a, "База данных тенанта A", "PostgreSQL", "Данные клиента A")
    ContainerDb(витрины_a, "Аналитическое хранилище A", "ClickHouse", "Витрины клиента A")
    ContainerDb(объекты_a, "Объектное хранилище A", "MinIO (S3)", "Видеофрагменты клиента A")
  }

  Container_Boundary(инстанс_b, "Экземпляр тенанта B — отдельное пространство имён") {
    Container(сервисы_b, "Прикладные сервисы тенанта B", "PHP (RoadRunner)", "Полный набор сервисов платформы")
    ContainerDb(бд_b, "База данных тенанта B", "PostgreSQL", "Данные клиента B")
    ContainerDb(витрины_b, "Аналитическое хранилище B", "ClickHouse", "Витрины клиента B")
    ContainerDb(объекты_b, "Объектное хранилище B", "MinIO (S3)", "Видеофрагменты клиента B")
  }
}

Rel(клиент_админ, апи_шлюз, "Работает с платформой", "HTTPS")
Rel(апи_шлюз, реестр, "Определяет экземпляр тенанта", "SQL")
Rel(апи_шлюз, сервисы_a, "Маршрутизирует запросы тенанта A", "REST")
Rel(апи_шлюз, сервисы_b, "Маршрутизирует запросы тенанта B", "REST")
Rel(сервисы_a, бд_a, "Читает и записывает", "SQL")
Rel(сервисы_a, витрины_a, "Пишет и читает витрины", "SQL")
Rel(сервисы_a, объекты_a, "Читает и записывает", "S3")
Rel(сервисы_b, бд_b, "Читает и записывает", "SQL")
Rel(сервисы_b, витрины_b, "Пишет и читает витрины", "SQL")
Rel(сервисы_b, объекты_b, "Читает и записывает", "S3")
Rel(оркестратор, инстанс_a, "Разворачивает и обновляет экземпляр", "Kubernetes API")
Rel(оркестратор, инстанс_b, "Разворачивает и обновляет экземпляр", "Kubernetes API")
Rel(оркестратор, реестр, "Регистрирует экземпляр и его версию", "SQL")
Rel(биллинг, реестр, "Читает подписки тенантов", "SQL")

note right of инстанс_a
  **Изоляция:** полная, на уровне
  вычислительных ресурсов и сети.
  Возможны индивидуальные версии ПО,
  размещение в своём регионе
  и собственные SLA.
end note

note bottom of оркестратор
  **Стоимость тенанта:** максимальная.
  Каждому клиенту — свой PostgreSQL,
  ClickHouse, MinIO и пул сервисов,
  даже при минимальной нагрузке.
end note

@enduml
