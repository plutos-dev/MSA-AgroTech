@startuml C1_Context_SaaS_ToBe
' =====================================================================
' C4 Level 1 — Context. Целевая архитектура To-Be
' SaaS-платформа мониторинга свинокомплексов
' =====================================================================

!include <C4/C4_Context>

title C1. Целевая архитектура To-Be — SaaS-платформа мониторинга свинокомплексов

LAYOUT_TOP_DOWN()

' ===================== Пользователи клиента =====================
Person(дежурный, "Дежурный сотрудник фермы", "Сотрудник клиента. Реагирует на инциденты на месте, работает при отсутствии связи")
Person(оператор, "Оператор мониторинга клиента", "Контролирует инциденты и состояние поголовья по фермам своей организации")
Person(админ_клиента, "Администратор клиента", "Управляет подпиской, тарифом, пользователями и фермами своей организации через панель самообслуживания")
Person(разработчик, "Разработчик интегратора", "Подключает системы клиента к платформе, работает с документацией и ключами доступа")

' ===================== Сотрудники вендора =====================
Person(менеджер, "Менеджер платформы", "Сотрудник вендора. Управляет тарифными планами, разбирает обращения, контролирует биллинг")

' ===================== Система в фокусе =====================
System(saas, "SaaS-платформа мониторинга свинокомплексов", "Мультитенантная платформа: видеоаналитика и управление оборудованием на фермах клиентов, мониторинг инцидентов, учёт поголовья и кормов, аналитика. Подписки, тарификация и биллинг, самообслуживание и публичный API для интеграций")

' ===================== Внешние системы =====================
System_Ext(видеонаблюдение, "Системы видеонаблюдения ферм клиентов", "IP-камеры и VMS разных производителей")
System_Ext(оборудование, "Технологическое оборудование ферм клиентов", "Кормушки, поилки, системы фильтрации воды разных производителей")
System_Ext(платежи, "Российские платёжные системы", "ЮKassa, СБП, банковский эквайринг. Приём платежей по подпискам от юридических лиц")
System_Ext(фискализация, "Облачная онлайн-касса", "Формирует чек по 54-ФЗ и передаёт его оператору фискальных данных (ОФД)")
System_Ext(учётные_системы, "Учётные системы клиентов", "ERP и складские системы агрохолдингов, включая «1С:Агро». Обмен данными о поголовье и кормах")
System_Ext(каталоги, "Корпоративные каталоги клиентов", "Провайдеры идентификации клиентов. Федерация для единого входа сотрудников")
System_Ext(каналы_оповещения, "Каналы оповещения", "SMS через GSM, сирены и световая сигнализация на фермах работают без интернета; push только при наличии связи")
System_Ext(партнёр_ml, "Партнёрский поставщик ML-моделей", "Обученные модели компьютерного зрения")

' ===================== Связи: пользователи =====================
Rel(дежурный, saas, "Получает оповещения и подтверждает инциденты на ферме")
Rel(оператор, saas, "Контролирует инциденты, поголовье и кормление")
Rel(админ_клиента, saas, "Управляет подпиской, тарифом, пользователями и фермами")
Rel(разработчик, saas, "Изучает документацию, получает ключи, разрабатывает интеграцию")
Rel(менеджер, saas, "Управляет тарифными планами и контролирует биллинг")

' ===================== Связи: фермы клиентов =====================
Rel(видеонаблюдение, saas, "Передаёт видеопоток", "RTSP / ONVIF")
BiRel(оборудование, saas, "Передаёт телеметрию, принимает команды", "MQTT / Modbus / OPC UA")
Rel(saas, каналы_оповещения, "Отправляет оповещения об инцидентах", "SMS / сухой контакт; push при наличии связи")

' ===================== Связи: монетизация =====================
Rel(saas, платежи, "Выставляет счета и принимает платежи по подпискам", "REST")
Rel(saas, фискализация, "Передаёт данные для формирования чеков", "REST")

' ===================== Связи: интеграции клиентов =====================
BiRel(saas, учётные_системы, "Обменивается данными о поголовье и кормах через публичный API", "REST / Webhook")
Rel(saas, каталоги, "Федерация единого входа сотрудников клиента", "OIDC / SAML")

' ===================== Связи: поставка моделей =====================
Rel(партнёр_ml, saas, "Поставляет и обновляет ML-модели")

@enduml
