@startuml C2_Isolation_SharedDb
' =====================================================================
' C4 Level 2 — Container (фрагмент)
' Вариант изоляции A: общий кластер БД, схема на тенанта
' =====================================================================

!include <C4/C4_Container>

title Вариант A. Изоляция на уровне схем БД\n(общий кластер, общий пул сервисов, схема на тенанта)

LAYOUT_TOP_DOWN()

Person(клиент_админ, "Администратор клиента", "Агрохолдинг-подписчик")

System_Boundary(saas, "SaaS-платформа мониторинга свинокомплексов") {

  Container_Boundary(control, "Control plane — общий для всех тенантов") {
    Container(апи_шлюз, "Публичный API-шлюз", "Kong", "Проверяет токен, извлекает идентификатор тенанта, применяет лимиты тарифа")
    Container(маршрутизатор, "Резолвер тенанта", "PHP", "По идентификатору тенанта возвращает имя схемы БД")
    Container(провижининг, "Сервис провижининга тенантов", "PHP", "При регистрации создаёт схему, накатывает миграции, наполняет справочники")
  }

  Container_Boundary(data, "Data plane — общий пул сервисов") {
    Container(сервисы, "Прикладные сервисы", "PHP (RoadRunner)", "Инциденты, реестр, кормление и поголовье, метрики. Один экземпляр обслуживает все тенанты, перед запросом переключает соединение на схему тенанта через search_path")
    ContainerDb(бд, "Кластер PostgreSQL", "PostgreSQL", "Схема shared: тарифы, справочники, реестр тенантов.\nСхемы tenant_001 … tenant_N: данные каждого клиента")
    ContainerDb(витрины, "Аналитическое хранилище", "ClickHouse", "Общие таблицы с обязательной колонкой tenant_id, политика доступа по строкам")
    ContainerDb(объекты, "Объектное хранилище", "MinIO (S3)", "Общий бакет, префикс пути на тенанта")
  }
}

Rel(клиент_админ, апи_шлюз, "Работает с платформой", "HTTPS")
Rel(апи_шлюз, сервисы, "Передаёт запрос с идентификатором тенанта из токена", "REST")
Rel(сервисы, маршрутизатор, "Запрашивает схему тенанта, кэширует ответ", "REST")
Rel(сервисы, бд, "Читает и записывает в схеме своего тенанта", "SQL, search_path")
Rel(сервисы, витрины, "Пишет и читает с фильтром по tenant_id", "SQL")
Rel(сервисы, объекты, "Читает и записывает по префиксу тенанта", "S3")
Rel(провижининг, бд, "Создаёт схему и накатывает миграции", "SQL / DDL")

note right of бд
  **Изоляция:** логическая, средствами СУБД.
  Соединение из пула с неверным или
  не сброшенным search_path читает
  данные чужого клиента. В ClickHouse
  данные разделяет только фильтр
  по tenant_id.
end note

note bottom of сервисы
  **Стоимость тенанта:** минимальная.
  Один пул сервисов и один кластер БД
  обслуживают сотни клиентов.
end note

@enduml
