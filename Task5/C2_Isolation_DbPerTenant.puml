@startuml C2_Isolation_DbPerTenant
' =====================================================================
' C4 Level 2 — Container (фрагмент)
' Вариант изоляции B: отдельная база данных на тенанта
' =====================================================================

!include <C4/C4_Container>

title Вариант B. Изоляция на уровне отдельных БД\n(общий пул сервисов, своя база данных у каждого тенанта)

LAYOUT_TOP_DOWN()

Person(клиент_админ, "Администратор клиента", "Агрохолдинг-подписчик")

System_Boundary(saas, "SaaS-платформа мониторинга свинокомплексов") {

  Container_Boundary(control, "Control plane — общий для всех тенантов") {
    Container(апи_шлюз, "Публичный API-шлюз", "Kong", "Проверяет токен, извлекает идентификатор тенанта, применяет лимиты тарифа")
    Container(маршрутизатор, "Резолвер тенанта", "PHP", "По идентификатору тенанта возвращает строку подключения из реестра и учётные данные из Vault")
    Container(провижининг, "Сервис провижининга тенантов", "PHP", "Создаёт базу данных, накатывает миграции, регистрирует строку подключения и секрет")
    ContainerDb(реестр_бд, "Реестр тенантов", "PostgreSQL", "Тенанты, тарифы, строки подключения, состояние миграций")
    Container(хранилище_секретов, "Хранилище секретов", "HashiCorp Vault", "Учётные данные подключения к базам тенантов")
  }

  Container_Boundary(data, "Data plane — общий пул сервисов, изолированные данные") {
    Container(сервисы, "Прикладные сервисы", "PHP (RoadRunner)", "Инциденты, реестр, кормление и поголовье, метрики. Один экземпляр обслуживает все тенанты. Соединение с базой тенанта открывается по параметрам от резолвера")
    ContainerDb(бд_1, "База данных тенанта A", "PostgreSQL", "Полностью изолированные данные клиента A")
    ContainerDb(бд_2, "База данных тенанта B", "PostgreSQL", "Полностью изолированные данные клиента B")
    ContainerDb(бд_n, "База данных тенанта N", "PostgreSQL", "…")
    ContainerDb(витрины, "Аналитическое хранилище", "ClickHouse", "База на тенанта либо общие таблицы с политикой доступа по строкам")
    ContainerDb(объекты, "Объектное хранилище", "MinIO (S3)", "Отдельный бакет и отдельная политика доступа на тенанта")
  }
}

Rel(клиент_админ, апи_шлюз, "Работает с платформой", "HTTPS")
Rel(апи_шлюз, сервисы, "Передаёт запрос с идентификатором тенанта из токена", "REST")
Rel(маршрутизатор, реестр_бд, "Читает строку подключения тенанта", "SQL")
Rel(маршрутизатор, хранилище_секретов, "Получает учётные данные подключения", "HTTPS")
Rel(сервисы, маршрутизатор, "Запрашивает параметры подключения тенанта, кэширует их", "REST")
Rel(сервисы, бд_1, "Читает и записывает", "SQL")
Rel(сервисы, бд_2, "Читает и записывает", "SQL")
Rel(сервисы, бд_n, "Читает и записывает", "SQL")
Rel(сервисы, витрины, "Пишет и читает данные тенанта", "SQL")
Rel(сервисы, объекты, "Читает и записывает в бакет тенанта", "S3")
Rel(провижининг, бд_n, "Создаёт базу и накатывает миграции", "SQL / DDL")
Rel(провижининг, реестр_бд, "Регистрирует тенанта", "SQL")

note right of бд_1
  **Изоляция:** на уровне СУБД.
  Утечка между клиентами требует
  ошибки в выборе соединения,
  а не в условии запроса.
  Возможно восстановление
  данных одного клиента.
end note

note bottom of провижининг
  **Эксплуатация:** миграции применяются
  к N базам. Нужен контроль версий схемы
  по каждому тенанту и обработка
  частично применённых миграций.
end note

@enduml
