@startuml C2_Container_SaaS_ToBe
' =====================================================================
' C4 Level 2 — Container. Целевая архитектура To-Be
' SaaS-платформа мониторинга свинокомплексов
' Модель изоляции: отдельная база данных на тенанта (вариант B)
' =====================================================================

!include <C4/C4_Container>

title C2. Целевая архитектура To-Be — SaaS-платформа мониторинга свинокомплексов\n(изоляция данных: отдельная база данных на тенанта)

LAYOUT_TOP_DOWN()

Person(дежурный, "Дежурный сотрудник фермы", "Сотрудник клиента")
Person(оператор, "Оператор мониторинга клиента", "Сотрудник клиента")
Person(админ_клиента, "Администратор клиента", "Подписка, тариф, пользователи, фермы")
Person(разработчик, "Разработчик интегратора", "Интеграция систем клиента")
Person(менеджер, "Менеджер платформы", "Сотрудник вендора")

System_Boundary(saas, "SaaS-платформа мониторинга свинокомплексов") {

  ' ---------------- Клиентские приложения ----------------
  Container_Boundary(клиенты, "Клиентские приложения") {
    Container(веб, "Веб-приложение платформы", "SPA (React)", "Инциденты, поголовье, кормление, отчёты, настройки в разрезе организации клиента")
    Container(мобильное, "Мобильное приложение", "Kotlin / Swift", "Оповещения и подтверждение инцидентов вне фермы")
    Container(самообслуживание, "Панель самообслуживания", "SPA (React)", "Регистрация организации, выбор и смена тарифа, управление пользователями и фермами, счета и платежи, потребление по лимитам")
    Container(dev_портал, "Портал разработчика", "Static site + OpenAPI UI", "Документация публичного API, спецификация OpenAPI, песочница, выпуск и отзыв ключей доступа, описание вебхуков")
  }

  ' ---------------- Control plane ----------------
  Container_Boundary(control, "Control plane — общий для всех тенантов") {
    Container(апи_шлюз, "Публичный API-шлюз", "Kong", "Единая точка входа. Проверка токена, извлечение тенанта, версионирование контракта, лимиты и квоты по тарифу")
    Container(резолвер, "Резолвер тенанта", "PHP", "По идентификатору тенанта возвращает параметры размещения данных и короткоживущие учётные данные из Vault")
    Container(тенанты, "Сервис тенантов и онбординга", "PHP", "Регистрация организации, жизненный цикл тенанта, пробный период, приостановка и закрытие")
    Container(провижининг, "Сервис провижининга", "PHP", "Создаёт базу данных тенанта, накатывает миграции, заводит realm в провайдере идентификации, создаёт бакет")
    Container(подписки, "Сервис подписок и тарификации", "PHP", "Тарифные планы, лимиты (фермы, камеры, объём хранения, вызовы API), правила перехода между тарифами")
    Container(потребление, "Сервис учёта потребления", "PHP", "Собирает показатели использования по тенантам для тарификации и контроля лимитов")
    Container(биллинг, "Сервис биллинга", "PHP", "Расчётные периоды, счета, акты, повторные списания, задолженность и блокировка при неоплате")
    Container(адаптер_платежей, "Адаптер платёжных систем", "PHP", "Антикоррупционный слой к ЮKassa, СБП и эквайрингу: платежи, возвраты, обработка нотификаций")
    Container(адаптер_фискализации, "Адаптер фискализации", "PHP", "Передача данных чека в облачную онлайн-кассу; касса формирует чек по 54-ФЗ и отправляет его в ОФД")
    Container(idp, "Провайдер идентификации", "Keycloak", "Realm на тенанта: изоляция пространств пользователей, единый вход, MFA, федерация с каталогом клиента")
    Container(шлюз_агентов, "Шлюз агентов ферм", "PHP (RoadRunner), gRPC", "Приём данных от агентов всех тенантов, выдача конфигурации и ML-моделей. Аутентификация агента по сервисным учётным данным с привязкой к тенанту")
    Container(модели, "Сервис управления ML-моделями", "PHP + Python", "Приём моделей от партнёра, версионирование, поэтапная выкатка по группам ферм и тенантов")
    ContainerDb(реестр_тенантов, "Реестр тенантов", "PostgreSQL", "Организации, подписки, тарифы, лимиты, строки подключения, счета и платежи")
    Container(секреты, "Хранилище секретов", "HashiCorp Vault", "Учётные данные подключения к базам тенантов, ключи платёжных систем")
  }

  ' ---------------- Data plane ----------------
  Container_Boundary(data, "Data plane — общий пул сервисов, изолированные данные тенантов") {
    Container(сервисы, "Прикладные сервисы", "PHP (RoadRunner)", "Инциденты, реестр ферм и устройств, кормление и поголовье, метрики и отчётность. Соединение с базой тенанта открывает общий компонент доступа к данным по параметрам от резолвера")
    ContainerDb(бд_тенанта, "Базы данных тенантов", "PostgreSQL", "Отдельная база на каждого клиента: инциденты, реестр объектов, поголовье, кормление, пользователи и роли")
    ContainerDb(витрины_тенанта, "Аналитические хранилища тенантов", "ClickHouse", "Витрины и история по каждому клиенту")
    ContainerDb(объекты_тенанта, "Объектные хранилища тенантов", "MinIO (S3)", "Отдельный бакет на клиента: видеофрагменты инцидентов")
  }

  ' ---------------- Агент фермы ----------------
  Container_Boundary(агент, "Агент фермы — экземпляр на каждой ферме клиента") {
    Container(агент_ферма, "Агент фермы", "PHP (RoadRunner), Python, Mosquitto, PostgreSQL + TimescaleDB, MinIO", "Видеоаналитика на edge, шлюз оборудования, локальный брокер, сервис инцидентов, локальные оповещения, интерфейс дежурного, синхронизация. Состав детализирован в Task2. Привязан к тенанту сервисными учётными данными")
  }
}

System_Ext(видеонаблюдение, "Системы видеонаблюдения ферм клиентов", "IP-камеры и VMS разных производителей")
System_Ext(оборудование, "Технологическое оборудование ферм клиентов", "Кормушки, поилки, системы фильтрации воды")
System_Ext(платежи, "Российские платёжные системы", "ЮKassa, СБП, банковский эквайринг")
System_Ext(фискализация, "Облачная онлайн-касса", "Чеки по 54-ФЗ, передача в ОФД")
System_Ext(учётные_системы, "Учётные системы клиентов", "ERP и складские системы агрохолдингов")
System_Ext(каталоги, "Корпоративные каталоги клиентов", "Провайдеры идентификации клиентов")
System_Ext(каналы_оповещения, "Каналы оповещения", "SMS через GSM и сирены работают без интернета; push только при наличии связи")
System_Ext(партнёр_ml, "Партнёрский поставщик ML-моделей", "Обученные модели компьютерного зрения")

' ===================== Связи: пользователи =====================
Rel(дежурный, агент_ферма, "Подтверждает инциденты в локальном интерфейсе фермы", "HTTPS, локальная сеть")
Rel(оператор, веб, "Контролирует инциденты и поголовье", "HTTPS")
Rel(оператор, мобильное, "Получает оповещения вне фермы", "HTTPS")
Rel(админ_клиента, самообслуживание, "Управляет подпиской, тарифом, пользователями и фермами", "HTTPS")
Rel(разработчик, dev_портал, "Изучает документацию, получает ключи, пробует API", "HTTPS")
Rel(менеджер, апи_шлюз, "Служебные операции с тарифами и биллингом; отдельного интерфейса нет, все действия в журнале аудита", "REST, служебный доступ")

' ===================== Связи: клиенты -> шлюз =====================
Rel(веб, апи_шлюз, "Выполняет запросы", "REST / WebSocket")
Rel(мобильное, апи_шлюз, "Выполняет запросы", "REST")
Rel(самообслуживание, апи_шлюз, "Выполняет запросы управления подпиской", "REST")
Rel(dev_портал, апи_шлюз, "Выпускает ключи, выполняет запросы песочницы", "REST")
Rel(учётные_системы, апи_шлюз, "Интегрируются через публичный API", "REST")
Rel(апи_шлюз, учётные_системы, "Доставляет события подписчикам", "Webhook")

' ===================== Связи: control plane =====================
Rel(апи_шлюз, idp, "Проверяет токены и получает роли", "OIDC / OAuth 2.0")
Rel(апи_шлюз, сервисы, "Маршрутизирует запрос с идентификатором тенанта из проверенного токена", "REST")
Rel(апи_шлюз, подписки, "Проверяет лимиты и квоты тарифа", "REST")
Rel(апи_шлюз, тенанты, "Запросы онбординга и управления организацией", "REST")
Rel(апи_шлюз, биллинг, "Запросы по счетам и платежам", "REST")
Rel(резолвер, реестр_тенантов, "Читает параметры размещения данных", "SQL")
Rel(резолвер, секреты, "Получает учётные данные подключения", "HTTPS")
Rel(сервисы, резолвер, "Запрашивает параметры подключения тенанта, кэширует их", "REST")
Rel(тенанты, провижининг, "Инициирует создание инфраструктуры тенанта", "REST")
Rel(тенанты, реестр_тенантов, "Читает и записывает", "SQL")
Rel(провижининг, бд_тенанта, "Создаёт базу и накатывает миграции", "SQL / DDL")
Rel(провижининг, idp, "Создаёт realm и первого администратора", "Admin API")
Rel(провижининг, объекты_тенанта, "Создаёт бакет и политику доступа", "S3 API")
Rel(провижининг, секреты, "Сохраняет учётные данные подключения", "HTTPS")
Rel(подписки, реестр_тенантов, "Читает и записывает тарифы и лимиты", "SQL")
Rel(потребление, сервисы, "Собирает показатели использования по тенантам", "REST")
Rel(потребление, реестр_тенантов, "Записывает потребление за период", "SQL")
Rel(биллинг, потребление, "Запрашивает потребление за расчётный период", "REST")
Rel(биллинг, подписки, "Получает тариф и правила расчёта", "REST")
Rel(биллинг, реестр_тенантов, "Записывает счета и платежи", "SQL")
Rel(биллинг, адаптер_платежей, "Инициирует списание или выставление счёта", "REST")
Rel(биллинг, адаптер_фискализации, "Передаёт данные для чека", "REST")
Rel(биллинг, тенанты, "Приостанавливает тенанта при задолженности", "REST")
Rel(адаптер_платежей, платежи, "Создаёт платёж, принимает нотификации", "REST")
Rel(адаптер_платежей, секреты, "Получает ключи платёжных систем", "HTTPS")
Rel(адаптер_фискализации, фискализация, "Передаёт данные чека", "REST")
Rel(idp, каталоги, "Федерация единого входа сотрудников клиента", "OIDC / SAML")

' ===================== Связи: data plane =====================
Rel(сервисы, бд_тенанта, "Читает и записывает в базе своего тенанта", "SQL")
Rel(сервисы, витрины_тенанта, "Пишет и читает витрины тенанта", "SQL")
Rel(сервисы, объекты_тенанта, "Читает и записывает в бакете тенанта", "S3")

' ===================== Связи: фермы =====================
Rel(видеонаблюдение, агент_ферма, "Передаёт видеопоток", "RTSP / ONVIF")
BiRel(агент_ферма, оборудование, "Принимает телеметрию, отправляет команды", "MQTT / Modbus / OPC UA")
Rel(агент_ферма, каналы_оповещения, "Отправляет оповещения дежурному", "SMS / сухой контакт; push при наличии связи")
BiRel(агент_ферма, шлюз_агентов, "Передаёт инциденты, телеметрию и метрики; получает конфигурацию и модели", "gRPC / HTTPS, задержка до 10 мин")
Rel(шлюз_агентов, сервисы, "Передаёт данные ферм с идентификатором тенанта из учётных данных агента", "REST")
Rel(модели, шлюз_агентов, "Отдаёт обновления ML-моделей", "REST")
Rel(партнёр_ml, модели, "Поставляет и обновляет ML-модели")

@enduml
