@startuml C2_Integration_AgroTechAsClient
' =====================================================================
' C4 Level 2 — Container (фрагмент)
' Пример интеграции: «АгроТех Х» как клиент SaaS-платформы
' =====================================================================

!include <C4/C4_Container>

title C2. Пример интеграции — «АгроТех Х» как тенант SaaS-платформы\n(свинофермы компании, обмен с корпоративным ландшафтом через публичный API)

LAYOUT_TOP_DOWN()

Person(дежурный, "Дежурный сотрудник фермы", "Сотрудник «АгроТех Х»")
Person(оператор, "Оператор мониторинга", "Сотрудник «АгроТех Х»")
Person(админ_клиента, "Администратор «АгроТех Х»", "Управляет подпиской и пользователями организации")
Person(аналитик, "Аналитик «АгроТех Х»", "Работает в корпоративном BI")

System_Boundary(saas, "SaaS-платформа мониторинга свинокомплексов") {

  Container_Boundary(control, "Control plane — общий для всех тенантов") {
    Container(апи_шлюз, "Публичный API-шлюз", "Kong", "Проверка токена, контекст тенанта «АгроТех Х», лимиты тарифа")
    Container(idp, "Провайдер идентификации", "Keycloak", "Realm «АгроТех Х», федерация с корпоративным каталогом компании")
    Container(шлюз_агентов, "Шлюз агентов ферм", "PHP (RoadRunner), gRPC", "Приём данных от агентов всех ферм «АгроТех Х»")
    Container(биллинг, "Сервис биллинга", "PHP", "Счета по подписке организации")
  }

  Container_Boundary(tenant, "Тенант «АгроТех Х» — изолированные данные") {
    Container(сервисы, "Прикладные сервисы", "PHP (RoadRunner)", "Инциденты, реестр, кормление и поголовье, метрики")
    ContainerDb(бд, "База данных тенанта «АгроТех Х»", "PostgreSQL", "Инциденты, реестр ферм, поголовье, кормление")
    ContainerDb(витрины, "Аналитическое хранилище тенанта", "ClickHouse", "Витрины по фермам «АгроТех Х»")
    ContainerDb(объекты, "Объектное хранилище тенанта", "MinIO (S3)", "Видеофрагменты инцидентов")
  }

  Container_Boundary(фермы, "Агенты ферм «АгроТех Х»") {
    Container(агент, "Агент фермы", "PHP, Python, Mosquitto, PostgreSQL + TimescaleDB", "Экземпляр на каждой свиноферме. Работают автономно при обрыве связи")
  }

  Container(веб, "Веб-приложение платформы", "SPA (React)", "Рабочее место оператора «АгроТех Х»")
  Container(самообслуживание, "Панель самообслуживания", "SPA (React)", "Подписка, тариф, пользователи, счета")
}

' ===================== Корпоративный ландшафт «АгроТех Х» =====================
System_Boundary(агротех, "IT-ландшафт «АгроТех Х»") {
  Container(ерп, "ERP «1С:Агро»", "1С", "Складской учёт кормов, поголовье как актив, финансы")
  Container(kafka, "Корпоративная шина данных", "Apache Kafka", "Шина обмена между системами компании")
  Container(интеграционный_сервис, "Сервис интеграции с платформой", "PHP / Go", "Разработан «АгроТех Х» по документации портала разработчика. Забирает данные через публичный API, принимает вебхуки, публикует в корпоративную шину")
  ContainerDb(dwh, "Корпоративное хранилище", "ClickHouse", "Единое хранилище компании: теплицы, поля, техника, животноводство")
  Container(bi, "BI-система", "Power BI", "Корпоративная отчётность")
  Container(каталог, "Корпоративный каталог", "LDAP / IdP", "Учётные записи сотрудников компании")
}

System_Ext(оборудование, "Оборудование ферм «АгроТех Х»", "Камеры, кормушки, поилки, системы фильтрации воды")
System_Ext(каналы_оповещения, "Каналы оповещения", "SMS через GSM и сирены работают без интернета; push только при наличии связи")
System_Ext(платежи, "Российские платёжные системы", "ЮKassa, СБП, эквайринг")

' ===================== Связи: сотрудники =====================
Rel(дежурный, агент, "Подтверждает инциденты в локальном интерфейсе фермы", "HTTPS, локальная сеть")
Rel(оператор, веб, "Контролирует инциденты по всем фермам компании", "HTTPS")
Rel(админ_клиента, самообслуживание, "Управляет подпиской и пользователями", "HTTPS")
Rel(аналитик, bi, "Строит корпоративную отчётность", "Power BI")

' ===================== Связи: вход и единый вход =====================
Rel(веб, апи_шлюз, "Выполняет запросы", "REST / WebSocket")
Rel(самообслуживание, апи_шлюз, "Выполняет запросы управления подпиской", "REST")
Rel(апи_шлюз, idp, "Проверяет токены", "OIDC")
Rel(idp, каталог, "Федерация единого входа сотрудников «АгроТех Х»", "OIDC / LDAP")

' ===================== Связи: фермы =====================
Rel(оборудование, агент, "Передаёт видеопоток и телеметрию", "RTSP / MQTT / Modbus")
Rel(агент, каналы_оповещения, "Оповещает дежурного не позднее 5 секунд", "SMS / сухой контакт; push при наличии связи")
Rel(агент, шлюз_агентов, "Передаёт инциденты и метрики, получает конфигурацию", "gRPC / HTTPS")
Rel(шлюз_агентов, сервисы, "Передаёт данные в контексте тенанта", "REST")
Rel(сервисы, бд, "Читает и записывает", "SQL")
Rel(сервисы, витрины, "Пишет и читает витрины", "SQL")
Rel(сервисы, объекты, "Читает и записывает видеофрагменты", "S3")
Rel(апи_шлюз, сервисы, "Маршрутизирует запросы тенанта", "REST")

' ===================== Связи: интеграция с ландшафтом =====================
Rel(интеграционный_сервис, апи_шлюз, "Забирает поголовье, расход кормов и метрики", "REST, публичный API")
Rel(апи_шлюз, интеграционный_сервис, "Доставляет события об инцидентах", "Webhook")
Rel(интеграционный_сервис, kafka, "Публикует события и метрики животноводства", "Kafka")
BiRel(интеграционный_сервис, ерп, "Передаёт расход кормов и поголовье, получает остатки", "REST")
Rel(kafka, dwh, "Поставляет данные существующим ETL", "Kafka Connect / Airflow")
Rel(dwh, bi, "Предоставляет данные для отчётности", "SQL / ODBC")

' ===================== Связи: монетизация =====================
Rel(биллинг, платежи, "Выставляет счёт по подписке организации", "REST")
Rel(админ_клиента, платежи, "Оплачивает счёт", "Банковский перевод / эквайринг")

@enduml
