@startuml C3_Component_Alternative
' =====================================================================
' C4 Level 3 — Component
' Контейнер: «Сервис метрик, отчётности и интеграций» (центр)
' Вариант: АЛЬТЕРНАТИВНЫЙ (автономный)
' =====================================================================

!include <C4/C4_Component>

title C3. Сервис метрик, отчётности и интеграций — альтернативный вариант\n(собственные витрины и открытый API вместо корпоративной шины)

LAYOUT_TOP_DOWN()

Container_Ext(шлюз_агентов, "Шлюз агентов ферм", "PHP (RoadRunner), gRPC", "Телеметрия и метрики, пришедшие с ферм")
Container_Ext(апи_шлюз, "API-шлюз", "Kong / Nginx", "Запросы собственных клиентов и внешних потребителей")
ContainerDb_Ext(бд_центра, "Центральная БД", "PostgreSQL", "Определения метрик, подписки потребителей")
ContainerDb_Ext(аналитическое_хранилище, "Аналитическое хранилище", "ClickHouse", "Витрины: телеметрия, метрики, история инцидентов и поголовья")
System_Ext(внешние_потребители, "Внешние системы — потребители метрик", "Забирают метрики по открытому API или получают вебхуки")

Container_Boundary(сервис, "Сервис метрик, отчётности и интеграций") {
  Component(апи_метрик, "Контроллер управления метриками", "PHP, REST", "Создание, изменение и отключение пользовательских метрик администратором")
  Component(валидатор, "Валидатор определений", "PHP", "Проверяет корректность источника, формулы агрегации, периода и разрезов до сохранения определения")
  Component(реестр_метрик, "Реестр определений метрик", "PHP", "Хранит базовые и пользовательские определения. Добавление метрики не требует изменения кода")
  Component(приёмник, "Приёмник данных ферм", "PHP", "Принимает телеметрию и предрассчитанные метрики от шлюза агентов, обеспечивает идемпотентность по идентификатору пакета")
  Component(планировщик, "Планировщик расчёта", "PHP, cron-воркер", "Запускает расчёт метрик по периодам, указанным в определениях")
  Component(агрегатор, "Движок агрегации", "PHP", "Вычисляет значение метрики по определению: выбор стратегии агрегации, применение разрезов и периода")
  Component(писатель_витрин, "Писатель аналитических витрин", "PHP, ClickHouse-клиент", "Пакетная загрузка телеметрии и рассчитанных метрик в собственное аналитическое хранилище")
  Component(построитель_отчётов, "Построитель отчётов", "PHP", "Формирует отчёты по эффективности животноводства поверх витрин, заменяя корпоративный BI")
  Component(публичный_апи, "Контроллер публичного API метрик", "PHP, REST", "Опубликованный контракт для внешних потребителей: выборка метрик, пагинация, версионирование")
  Component(вебхуки, "Диспетчер вебхуков", "PHP", "Отправляет события подписчикам, управляет повторными попытками и подписками")
  Component(репозиторий, "Репозиторий метрик", "PHP, PDO", "Чтение и запись определений, подписок и рассчитанных значений")
}

Rel(апи_шлюз, апи_метрик, "Управление пользовательскими метриками", "REST")
Rel(апи_шлюз, публичный_апи, "Запросы внешних потребителей", "REST")
Rel(апи_метрик, валидатор, "Проверяет определение")
Rel(валидатор, реестр_метрик, "Сохраняет корректное определение")
Rel(реестр_метрик, репозиторий, "Читает и записывает определения")
Rel(шлюз_агентов, приёмник, "Передаёт телеметрию и метрики ферм", "REST")
Rel(приёмник, репозиторий, "Сохраняет исходные значения")
Rel(приёмник, писатель_витрин, "Передаёт телеметрию на загрузку в витрины")
Rel(планировщик, агрегатор, "Запускает расчёт по расписанию")
Rel(агрегатор, реестр_метрик, "Читает определения метрик")
Rel(агрегатор, репозиторий, "Читает исходные и записывает рассчитанные значения")
Rel(агрегатор, писатель_витрин, "Передаёт рассчитанные значения")
Rel(агрегатор, вебхуки, "Инициирует уведомление подписчиков")
Rel(репозиторий, бд_центра, "Читает и записывает", "SQL")
Rel(писатель_витрин, аналитическое_хранилище, "Пакетная загрузка", "HTTP / native")
Rel(построитель_отчётов, аналитическое_хранилище, "Выполняет аналитические запросы", "SQL")
Rel(публичный_апи, репозиторий, "Читает рассчитанные значения")
Rel(публичный_апи, внешние_потребители, "Отдаёт метрики по опубликованному контракту", "REST")
Rel(вебхуки, внешние_потребители, "Доставляет события подписчикам", "Webhook")

@enduml
