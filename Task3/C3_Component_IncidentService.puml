@startuml C3_Component_IncidentService
' =====================================================================
' C4 Level 3 — Component
' Контейнер: «Сервис инцидентов фермы» (агент фермы)
' Общий для основного и альтернативного вариантов: контур фермы идентичен
' =====================================================================

!include <C4/C4_Component>

title C3. Сервис инцидентов фермы — компонентная диаграмма\n(общая для основного и альтернативного вариантов)

LAYOUT_TOP_DOWN()

Container_Ext(брокер_фермы, "Брокер сообщений фермы", "Eclipse Mosquitto (MQTT)", "Детекции видеоаналитики и телеметрия оборудования")
Container_Ext(оповещения_фермы, "Сервис локальных оповещений", "PHP (RoadRunner)", "Доставка тревоги дежурному")
Container_Ext(панель_фермы, "Локальный интерфейс дежурного", "SPA (Vue) + PHP API", "Просмотр и подтверждение инцидентов")
ContainerDb_Ext(бд_фермы, "Локальная БД фермы", "PostgreSQL + TimescaleDB", "Инциденты, телеметрия, правила, очередь исходящих событий")
ContainerDb_Ext(хранилище_фрагментов, "Локальное хранилище видеофрагментов", "MinIO (S3)", "Кадры и фрагменты-подтверждения")

Container_Boundary(сервис, "Сервис инцидентов фермы") {
  Component(подписчик, "Подписчик событий", "PHP, php-mqtt", "Долгоживущий процесс. Подписан на топики детекций и телеметрии, обеспечивает переподключение и подтверждение доставки")
  Component(нормализатор, "Нормализатор событий", "PHP", "Приводит детекции видеоаналитики и показания оборудования к единому внутреннему представлению события")
  Component(правила, "Движок правил тревог", "PHP", "Применяет к событию набор правил: пороги телеметрии, классы детекций, уровни уверенности модели. Правила декларативны и загружаются из конфигурации")
  Component(дедупликатор, "Дедупликатор", "PHP", "Схлопывает повторные срабатывания по одной секции в рамках окна подавления, предотвращая лавину оповещений")
  Component(классификатор, "Классификатор приоритета", "PHP", "Делит инциденты на экстренные (беспокойное поведение, драка, задавливание) и плановые (болезнь, падёж), определяя канал и срочность реакции")
  Component(менеджер, "Менеджер жизненного цикла инцидента", "PHP", "Создание, подтверждение, закрытие и эскалация инцидента. Единственная точка изменения статуса")
  Component(диспетчер, "Диспетчер оповещений", "PHP", "Передаёт экстренный инцидент на оповещение, контролирует укладывание в 5 секунд и фиксирует факт доставки")
  Component(команды, "Публикатор команд оборудованию", "PHP", "Формирует и публикует команды оборудованию, порождённые правилами: блокировка подачи корма, повторный запуск поения")
  Component(репозиторий, "Репозиторий инцидентов", "PHP, PDO", "Чтение и запись инцидентов, их статусов и связанных показаний")
  Component(outbox, "Писатель очереди исходящих событий", "PHP", "В одной транзакции с изменением инцидента записывает событие в очередь для передачи в центр (transactional outbox)")
  Component(конфигурация, "Поставщик конфигурации", "PHP", "Предоставляет актуальные правила тревог, пороги и расписания, полученные из центра")
}

Rel(брокер_фермы, подписчик, "Доставляет детекции и телеметрию", "MQTT")
Rel(подписчик, нормализатор, "Передаёт сырое событие")
Rel(нормализатор, правила, "Передаёт нормализованное событие")
Rel(конфигурация, правила, "Предоставляет набор правил и порогов")
Rel(конфигурация, бд_фермы, "Читает конфигурацию", "SQL")
Rel(правила, дедупликатор, "Передаёт сработавшее правило")
Rel(дедупликатор, классификатор, "Передаёт уникальное срабатывание")
Rel(классификатор, менеджер, "Передаёт срабатывание с приоритетом")
Rel(менеджер, репозиторий, "Сохраняет инцидент и статус")
Rel(менеджер, outbox, "Записывает событие для синхронизации")
Rel(менеджер, диспетчер, "Передаёт экстренный инцидент", "≤ 5 с")
Rel(правила, команды, "Инициирует команду оборудованию")
Rel(диспетчер, оповещения_фермы, "Запрашивает доставку оповещения")
Rel(команды, брокер_фермы, "Публикует команду", "MQTT")
Rel(репозиторий, бд_фермы, "Читает и записывает", "SQL")
Rel(outbox, бд_фермы, "Записывает в очередь исходящих", "SQL")
Rel(менеджер, хранилище_фрагментов, "Связывает инцидент с фрагментом-подтверждением", "S3")
Rel(панель_фермы, менеджер, "Подтверждает и закрывает инцидент", "REST")

@enduml
