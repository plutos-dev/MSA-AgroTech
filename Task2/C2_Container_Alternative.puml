@startuml C2_Container_Alternative
' =====================================================================
' C4 Level 2 — Container
' Система: Платформа мониторинга свинокомплексов (MVP)
' Вариант: АЛЬТЕРНАТИВНЫЙ (автономный) — самодостаточное решение
' Контур фермы идентичен основному варианту, различия сосредоточены в центре
' =====================================================================

!include <C4/C4_Container>

title C2. Платформа мониторинга свинокомплексов — альтернативный вариант\n(автономное решение, минимум связей с ландшафтом «АгроТех Х»)

LAYOUT_TOP_DOWN()

' ===================== Акторы =====================
Person(дежурный, "Дежурный сотрудник фермы", "Реагирует на инциденты на месте")
Person(оператор, "Оператор центрального мониторинга", "Контролирует инциденты по всем фермам")
Person(администратор, "Администратор платформы", "Управляет пользователями, фермами, устройствами и правилами тревог")
Person(аналитик, "Аналитик", "Строит отчётность по эффективности животноводства")

System_Boundary(платформа, "Платформа мониторинга свинокомплексов") {

  ' ------------------- Контур фермы — идентичен основному варианту -------------------
  Container_Boundary(агент, "Агент фермы — экземпляр на каждой ферме") {
    Container(видеоаналитика, "Сервис видеоаналитики", "Python, TensorRT / edge-устройство NVIDIA Jetson", "Принимает видеопоток, выполняет инференс ML-модели, детектирует драки, задавливание, признаки болезни, выполняет пересчёт поголовья по секциям. Видео за пределы фермы не выходит")
    Container(шлюз_оборудования, "Шлюз оборудования фермы", "PHP (RoadRunner), адаптеры MQTT / Modbus / OPC UA", "Унифицирует протоколы производителей, принимает телеметрию кормушек, поилок и систем фильтрации, исполняет расписания кормления и поения")
    Container(брокер_фермы, "Брокер сообщений фермы", "Eclipse Mosquitto (MQTT)", "Локальная шина: развязывает источники событий и обработчики")
    Container(инциденты_фермы, "Сервис инцидентов фермы", "PHP (RoadRunner)", "Применяет правила тревог к детекциям и телеметрии, формирует и дедуплицирует инциденты, ведёт их статусы")
    Container(оповещения_фермы, "Сервис локальных оповещений", "PHP (RoadRunner)", "Доставляет тревогу дежурному не позднее 5 секунд. Работает при отсутствии интернета: GSM-канал, сирена, световая сигнализация")
    Container(панель_фермы, "Локальный интерфейс дежурного", "SPA (Vue) + PHP API", "Просмотр и подтверждение инцидентов на месте. Аутентификация по кэшированным учётным данным, работает без связи с центром")
    Container(синхронизация, "Сервис синхронизации с центром", "PHP (RoadRunner), transactional outbox", "Буферизует события при обрыве связи, передаёт инциденты, телеметрию и метрики в центр с задержкой до 10 минут, принимает конфигурацию и обновления ML-моделей")
    ContainerDb(бд_фермы, "Локальная БД фермы", "PostgreSQL + TimescaleDB", "Инциденты, телеметрия, поголовье, конфигурация, очередь исходящих событий")
    ContainerDb(хранилище_фрагментов, "Локальное хранилище видеофрагментов", "MinIO (S3)", "Короткие фрагменты и кадры, подтверждающие инцидент")
  }

  ' ------------------- Центральная система — всё своё -------------------
  Container_Boundary(центр, "Центральная система — головной офис") {
    Container(шлюз_агентов, "Шлюз агентов ферм", "PHP (RoadRunner), gRPC / HTTPS", "Единая точка приёма данных от агентов и выдачи им конфигурации и моделей. Аутентифицирует агентов по сервисным учётным данным")
    Container(апи_шлюз, "API-шлюз", "Kong / Nginx", "Единая точка входа для собственных клиентов и для внешних потребителей. Проверка токенов, маршрутизация, версионирование публичного API, rate limiting")
    Container(веб_приложение, "Веб-приложение платформы", "SPA (React)", "Собственный интерфейс оператора, аналитика и администратора: инциденты, поголовье, кормление, отчёты, настройки")
    Container(мобильное_приложение, "Мобильное приложение платформы", "Kotlin / Swift", "Собственный мобильный клиент: оповещения, просмотр и подтверждение инцидентов вне фермы")
    Container(реестр, "Сервис реестра ферм и устройств", "PHP", "Реестр ферм, секций, камер и оборудования. Хранит расписания кормления и поения и правила тревог, раздаёт конфигурацию агентам")
    Container(инциденты_центра, "Сервис инцидентов", "PHP", "Сводная картина инцидентов по всем фермам, статусы отработки, контроль SLA")
    Container(поголовье, "Сервис поголовья и кормов", "PHP", "Собственный учёт поголовья и запасов кормов, прогноз расхода. Расхождение пересчёта фиксируется как инцидент и подтверждается оператором. Выгрузка в ERP через антикоррупционный адаптер")
    Container(пользователи, "Сервис пользователей и ролей", "PHP", "Учётные записи, роли и права в разрезе ферм. Управляет пространствами пользователей в собственном IdP, ведёт журнал изменений прав")
    Container(модели, "Сервис управления ML-моделями", "PHP + Python", "Приём моделей от партнёра, версионирование, поэтапная выкатка на агенты ферм")
    Container(метрики, "Сервис метрик, отчётности и интеграций", "PHP", "Базовые и пользовательские метрики, построение витрин и отчётов, публикация метрик во внешние системы")
    Container(idp, "Провайдер идентификации", "Keycloak", "Собственный экземпляр в составе решения: единый вход, MFA, ролевая модель, изоляция пространств пользователей")
    ContainerDb(бд_центра, "Центральная БД", "PostgreSQL", "Реестр объектов, сводные инциденты, поголовье, кормление, метрики, пользователи и роли")
    ContainerDb(аналитическое_хранилище, "Аналитическое хранилище", "ClickHouse", "Собственные витрины: телеметрия, метрики, история инцидентов и поголовья")
    ContainerDb(объектное_хранилище, "Объектное хранилище центра", "MinIO (S3)", "Видеофрагменты инцидентов, собранные с ферм")
  }
}

' ===================== Внешние системы =====================
System_Ext(видеонаблюдение, "Системы видеонаблюдения ферм", "IP-камеры и VMS разных производителей")
System_Ext(оборудование_ферм, "Технологическое оборудование ферм", "Кормушки, поилки, системы фильтрации воды")
System_Ext(ерп, "ERP «1С:Агро»", "Складской учёт кормов, поголовье как актив, финансы. Принимает выгрузку")
System_Ext(внешние_потребители, "Внешние системы — потребители метрик", "Корпоративные и сторонние системы, забирающие метрики и события по открытому API")
System_Ext(каналы_оповещения, "Каналы оповещения", "SMS через GSM, сирена и световая сигнализация работают без интернета; push только при наличии связи")
System_Ext(партнёр_ml, "Партнёрский поставщик ML-моделей", "Обученные модели компьютерного зрения")

' ===================== Связи: контур фермы =====================
Rel(видеонаблюдение, видеоаналитика, "Передаёт видеопоток", "RTSP / ONVIF")
Rel(видеоаналитика, брокер_фермы, "Публикует детекции событий", "MQTT")
Rel(видеоаналитика, хранилище_фрагментов, "Сохраняет фрагмент-подтверждение", "S3")
BiRel(шлюз_оборудования, оборудование_ферм, "Принимает телеметрию, отправляет команды кормления и поения", "MQTT / Modbus / OPC UA")
Rel(шлюз_оборудования, брокер_фермы, "Публикует телеметрию", "MQTT")
Rel(шлюз_оборудования, бд_фермы, "Читает расписания кормления и поения", "SQL")
Rel(брокер_фермы, инциденты_фермы, "Доставляет детекции и телеметрию", "MQTT")
Rel(инциденты_фермы, брокер_фермы, "Публикует команды оборудованию", "MQTT")
Rel(инциденты_фермы, бд_фермы, "Сохраняет инциденты, телеметрию и поголовье", "SQL")
Rel(инциденты_фермы, оповещения_фермы, "Передаёт инцидент на оповещение", "≤ 5 с")
Rel(оповещения_фермы, каналы_оповещения, "Отправляет оповещение", "SMS / сухой контакт; push при наличии связи")
Rel(каналы_оповещения, дежурный, "Доставляет оповещение")
Rel(дежурный, панель_фермы, "Просматривает и подтверждает инциденты", "HTTPS, локальная сеть фермы")
Rel(панель_фермы, бд_фермы, "Читает инциденты и состояние фермы", "SQL")
Rel(синхронизация, бд_фермы, "Читает очередь исходящих событий, записывает конфигурацию", "SQL")
Rel(синхронизация, хранилище_фрагментов, "Читает фрагменты для передачи в центр", "S3")
Rel(синхронизация, видеоаналитика, "Доставляет обновления ML-моделей")

' ===================== Связи: ферма <-> центр =====================
BiRel(синхронизация, шлюз_агентов, "Передаёт инциденты, телеметрию и метрики; получает конфигурацию и модели", "gRPC / HTTPS, задержка до 10 мин")

' ===================== Связи: центр =====================
Rel(шлюз_агентов, инциденты_центра, "Передаёт инциденты ферм", "REST")
Rel(шлюз_агентов, поголовье, "Передаёт поголовье и фактический расход кормов", "REST")
Rel(шлюз_агентов, метрики, "Передаёт телеметрию и метрики", "REST")
Rel(шлюз_агентов, объектное_хранилище, "Складывает видеофрагменты инцидентов", "S3")
Rel(реестр, шлюз_агентов, "Отдаёт конфигурацию, расписания и правила тревог", "REST")
Rel(модели, шлюз_агентов, "Отдаёт обновления ML-моделей", "REST")
Rel(апи_шлюз, инциденты_центра, "Маршрутизирует запросы", "REST / WebSocket")
Rel(апи_шлюз, поголовье, "Маршрутизирует запросы", "REST")
Rel(апи_шлюз, реестр, "Маршрутизирует запросы", "REST")
Rel(апи_шлюз, пользователи, "Маршрутизирует запросы администрирования доступа", "REST")
Rel(апи_шлюз, метрики, "Маршрутизирует запросы к метрикам и отчётам, включая определение пользовательских", "REST")
Rel(апи_шлюз, idp, "Проверяет токены и получает роли", "OIDC / OAuth 2.0")
Rel(инциденты_центра, бд_центра, "Читает и записывает", "SQL")
Rel(поголовье, бд_центра, "Читает и записывает", "SQL")
Rel(реестр, бд_центра, "Читает и записывает", "SQL")
Rel(пользователи, бд_центра, "Читает и записывает", "SQL")
Rel(метрики, бд_центра, "Читает и записывает определения и значения метрик", "SQL")
Rel(пользователи, idp, "Управляет учётными записями и пространствами пользователей", "Admin API")
Rel(метрики, аналитическое_хранилище, "Записывает телеметрию и метрики, строит витрины", "SQL")
Rel(инциденты_центра, объектное_хранилище, "Читает видеофрагменты инцидентов", "S3")

' ===================== Связи: внешний мир =====================
Rel(оператор, веб_приложение, "Контролирует инциденты по всем фермам", "HTTPS")
Rel(оператор, мобильное_приложение, "Получает оповещения и подтверждает инциденты вне фермы", "HTTPS")
Rel(аналитик, веб_приложение, "Строит отчёты по эффективности животноводства", "HTTPS")
Rel(администратор, веб_приложение, "Настраивает фермы, устройства, роли и правила", "HTTPS")
Rel(веб_приложение, апи_шлюз, "Выполняет запросы", "REST / WebSocket")
Rel(мобильное_приложение, апи_шлюз, "Выполняет запросы", "REST")
Rel(апи_шлюз, внешние_потребители, "Предоставляет метрики и события по открытому API", "REST / Webhook")
Rel(поголовье, ерп, "Выгружает поголовье и фактический расход кормов", "REST")
Rel(партнёр_ml, модели, "Поставляет и обновляет ML-модели")

@enduml
